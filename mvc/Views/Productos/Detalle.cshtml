@model Producto

@{
    ViewData["Title"] = "Detalle del producto";
}

<h1>Detalle del producto</h1>

<div class="card mt-4">
    <div class="card-body">
        <h2 class="card-title h4">@Model.Nombre</h2>
        <p class="card-text">@Model.Descripcion</p>

        <dl class="row mb-0">
            <dt class="col-sm-3">Id</dt>
            <dd class="col-sm-9">@Model.Id</dd>

            <dt class="col-sm-3">Precio</dt>
            <dd class="col-sm-9">@Model.Precio.ToString("C")</dd>

            <dt class="col-sm-3">Stock</dt>
            <dd class="col-sm-9">@Model.Stock unidades</dd>
        </dl>
    </div>
</div>

<a class="btn btn-primary mt-3" asp-controller="Productos" asp-action="Listado">Volver al listado</a>
